{
  "name": "aurora-chat",
  "productName": "Aurora Chat",
  "version": "1.1.4",
  "description": "Aurora",
  "main": "main.js",
  "author": "Ciel",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^1.41.3",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.1.8",
    "express": "^4.22.1",
    "mongoose": "^9.6.1",
    "multer": "^2.1.1",
    "multer-storage-cloudinary": "^4.0.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.aurora.chat",
    "publish": [
      {
        "provider": "github",
        "owner": "collineaukazan-collab",
        "repo": "aurora-chat-server"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
